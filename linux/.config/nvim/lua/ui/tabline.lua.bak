local function dap_session()
  return package.loaded["dap"] and require("dap").session() or nil
end

local function dap_bar(session)
  local out = ""

  local paused = session.stopped_thread_id ~= nil
  local frame = paused and session.current_frame
  local location = ""
  if frame then
    location = location .. frame.name
    if frame.source and frame.source.path then
      local file = fn.fnamemodify(frame.source.path, ":t")
      local line = frame.line
      location = ("%s @ %s:%s"):format(location, file, line)
    end
    out = out .. with_hl(with_pad(location), "TabLineDapLocation")
  end

  local status = with_hl(require("dap").status(), "DiagnosticOk")
  local spaces = spaces_til_center(out, status)
  out = out .. "%*" .. spaces .. status

  out = out .. "%=" .. with_hl(
      -- with_pad("DEBUG · " .. (paused and "PAUSED" or "RUNNING")),
    with_pad(paused and "PAUSED" or "RUNNING"), paused and "TabLineDapPaused" or "TabLineDapRunning"
  )

  return out
end

