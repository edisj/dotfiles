  ["a"] = "ᵃ", ["b"] = "ᵇ", ["c"] = "ᶜ", ["d"] = "ᵈ", ["e"] = "ᵉ",
  ["f"] = "ᶠ", ["g"] = "ᵍ", ["h"] = "ʰ", ["i"] = "ⁱ", ["j"] = "ʲ",
  ["k"] = "ᵏ", ["l"] = "ˡ", ["m"] = "ᵐ", ["n"] = "ⁿ", ["o"] = "ᵒ",
  ["p"] = "ᵖ", ["q"] = "𐞥", ["r"] = "ʳ", ["s"] = "ˢ", ["t"] = "ᵗ",
  ["u"] = "ᵘ", ["v"] = "ᵛ", ["w"] = "ʷ", ["x"] = "ˣ", ["y"] = "ʸ",
  ["z"] = "ᶻ",
}
local subscript_letters = {
  ["a"] = "ₐ", ["b"] = "b", ["c"] = "c", ["d"] = "d", ["e"] = "ₑ",
  ["f"] = "f", ["g"] = "g", ["h"] = "ₕ", ["i"] = "ᵢ", ["j"] = "ⱼ",
  ["k"] = "ₖ", ["l"] = "ₗ", ["m"] = "ₘ", ["n"] = "ₙ", ["o"] = "ₒ",
  ["p"] = "ₚ", ["q"] = "q", ["r"] = "ᵣ", ["s"] = "ₛ", ["t"] = "ₜ",
  ["u"] = "ᵤ", ["v"] = "ᵥ", ["w"] = "w", ["x"] = "ₓ", ["y"] = "y",
  ["z"] = "z",
}
local function format_tab(name, key)
  local prevbuf = fs.abspath(api.nvim_buf_get_name(api.nvim_win_get_buf(fn.win_getid(fn.winnr("#")))))
  local curbuf = api.nvim_buf_get_name(0)
  local active = curbuf == fs.abspath(name) or prevbuf == fs.abspath(name)
  local hl = active and "TabLineSel" or "TabLine"
  local key_hl = active and "TabLineKeySel" or "TabLineKey"
  local isdir = name:sub(#name) == "/"
  local basename = fn.fnamemodify(name, isdir and ":h:t" or ":t") .. (isdir and "/" or "")
  -- local icon, icon_hl = icons.get("file", name)
  -- icon_hl = active and icon_hl or "Tabline"
  -- local tabtext = with_hl(icon, icon_hl) .. with_hl(basename, hl) .. with_hl(superscript_letters[key], key_hl)
  local tabtext = with_hl(basename, hl) .. with_hl(superscript_letters[key], key_hl)
  -- local text = border(active) .. tabtext
  return tabtext
end

local function arglist_tabs()
  if not (fn.argc() > 0 and _G.arglist) then return "" end
  return arglist.tabline(format_tab, "  ")
end

local function mux_session()
  if not package.loaded["mux"] then return "" end
  local name = (require("mux").get_state() or {}).name
  if name == nil then return "" end
  local icon = " "
  local icon = " "
  local icon = " "
  -- local icon = " "
  -- local icon = " "
  return with_pad(with_hl(icon, "String") .. "%*" .. name)
end

local _show_tabs = true
local function show_tabs()
  return _show_tabs and fn.argc() > 0
end

local function render()
  local session = dap_session()
  if session then return dap_bar(session) end

  local tabline = ""
  if show_tabs() then
    tabline = tabline .. tabnr()
    local tabs = arglist_tabs()
    local spaces = spaces_til_center(tabline, tabs)
    tabline = tabline .. spaces .. tabs
  else
    if #api.nvim_list_tabpages() > 1 then tabline = tabline .. tabnr() end
  end
  tabline = tabline .. "%*%=" .. git() .. mux_session()
  return tabline
end

map("<Leader>tt", function()
  _show_tabs = not _show_tabs
  vim.o.showtabline = _show_tabs and fn.argc() > 0 and 2 or 1
  vim.cmd("redrawtabline")
end)

on("User", augroup, { pattern = "ArgUpdate" }, function()
  vim.o.showtabline = _show_tabs and fn.argc() > 0 and 2 or 1
end)

local set_showtabline = function()
  local should_show = dap_session() ~= nil or (_show_tabs and fn.argc() > 0)
  vim.o.showtabline = should_show and 2 or 1
end

on("User", augroup, { pattern = "DapProgressUpdate" }, function()
  set_showtabline()
  vim.cmd("redrawtabline")
end)

_G.Tabline = render
vim.go.tabline = "%{%v:lua.Tabline()%}"
on("UIEnter", nil, function()
  set_showtabline()
  if package.loaded["dap"] then
    require("dap").listeners.after.event_initialized["my_dap"] = set_showtabline
    require("dap").listeners.after.event_exited["my_dap"] = set_showtabline
    require("dap").listeners.after.event_terminated["my_dap"] = set_showtabline
  end
end)
