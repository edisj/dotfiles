local api, fn, fs = vim.api, vim.fn, vim.fs
local icons = require("icons")

-- local TAB_ACTIVE = "󰝥"
-- local TAB_INACTIVE = "󰝦"
local augroup = api.nvim_create_augroup("plugin.tabline", { clear = true })

local function create_hl(target, ...)
  local merged_hl = {}
  for _, name in ipairs { ... } do
    local hl =
      type(name) == "string" and api.nvim_get_hl(0, { name = name, link = false })
      or name
    merged_hl = vim.tbl_deep_extend("keep", merged_hl, hl)
  end
  api.nvim_set_hl(0, target, merged_hl)
end

local function create_hls()
  create_hl("TabLineSelN", "Function",     "TabLineSel")
  create_hl("TabLineN",    "LineNr",       "TabLine")
  create_hl("TabLineSelI", "String",       "TabLineSel")
  create_hl("TabLineI",    "LineNr",       "TabLine")
  create_hl("TabLineSelV", "Keyword",      "TabLineSel")
  create_hl("TabLineV",    "LineNr",       "TabLine")
  create_hl("TabLineSelC", "DiagnosticOk", "TabLineSel")
  create_hl("TabLineC",    "LineNr",       "TabLine")

  create_hl("NInverted", { bold = true, reverse = true }, "Function")
  create_hl("IInverted", { bold = true, reverse = true }, "String")
  create_hl("VInverted", { bold = true, reverse = true }, "Keyword")
  create_hl("CInverted", { bold = true, reverse = true }, "DiagnosticOk")

  create_hl("TabLineKeySel", "Comment", "TabLineSel")
  create_hl("TabLineKey",    "LineNr", "TabLine")

  create_hl("TabLineDapRunning",  "DiagnosticError", "TabLineSel")
  create_hl("TabLineDapPaused",   "DiagnosticError", "TabLineSel")
  create_hl("TabLineDapType",     "Type",            "TabLineSel")
  create_hl("TabLineDapLocation", "Special",         "TabLineSel")
end

create_hls()
on("ColorScheme", augroup, create_hls)

local function with_hl(text, hl)
  return (hl and "%#" .. hl .. "#" .. text or text)
end

local function with_pad(text, pad)
  local spaces = string.rep(" ", pad or 1)
  return spaces .. text .. spaces
end

local mode_hlmap = setmetatable({
  n = { "TabLineSelN", "TabLineN" },
  i = { "TabLineSelI", "TabLineI" },
  v = { "TabLineSelV", "TabLineV" },
  c = { "TabLineSelC", "TabLineC" },
}, { __index = function(self, k) return {} end })

local mode_hlmap2 = setmetatable({
  n = { "NInverted", "TabLineN" },
  i = { "IInverted", "TabLineI" },
  v = { "VInverted", "TabLineV" },
  c = { "CInverted", "TabLineC" },
}, { __index = function() return {} end })


local function spaces_til_center(left, center)
  local min_spaces = 2
  local lw = api.nvim_eval_statusline(left, { use_tabline = true }).width
  local cw = api.nvim_eval_statusline(center, { use_tabline = true }).width
  local pad = math.max(min_spaces, math.floor((vim.o.columns - cw) / 2) - lw)
  return string.rep(" ", pad)
end

local function tabnr()
  local tabpages = api.nvim_list_tabpages()
  if #tabpages == 1 then return "" end

  local active_tabnr = api.nvim_tabpage_get_number(0)
  local tabs = {}
  local mode = fn.mode()
  for i, tabnr in ipairs(tabpages) do
    local buf = api.nvim_win_get_buf(api.nvim_tabpage_get_win(tabnr))
    local name = api.nvim_buf_get_name(buf)
    if name == "" then
      local bt = vim.bo[buf].buftype
      name = bt == "nofile" and "Scratch" or "No Name"
    end
    local id = tabpages[active_tabnr]
    -- local icon = id == tabnr and TAB_ACTIVE or TAB_INACTIVE
    local hl = id == tabnr and "TabLineSel" or "TabLine"
    -- local tabname = name:match("^%a[%w+.-]*:.*//(.*)$") or fn.fnamemodify(name, ":t")
    local tabname = fn.fnamemodify(name, ":t")
    tabs[#tabs + 1] = with_hl(i .. ":" .. tabname, hl)
  end
  return with_pad(table.concat(tabs, " "))
end


local function git()
  -- local gitsigns = vim.b.gitsigns_status_dict
  local gitsigns = vim.g.gitsigns_head
  if not gitsigns then return "" end
  local branch = with_hl(" ", "DiagnosticError") .. "%*" .. gitsigns
  -- local changes = {}
  -- changes[#changes + 1] = gitsigns.added and gitsigns.added ~= 0 and "+" .. gitsigns.added or nil
  -- changes[#changes + 1] = gitsigns.removed and gitsigns.removed ~= 0 and "-" .. gitsigns.removed or nil
  -- changes[#changes + 1] = gitsigns.changed and gitsigns.changed ~= 0 and "~" .. gitsigns.changed or nil
  -- local text = table.concat(changes, " ")
  -- if not_nil(text) then text = "(" .. text .. ")" end
  return with_pad(branch)
end

