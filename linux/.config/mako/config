anchor=top-right
default-timeout=5000
font=JetBrainsMono Nerd Font 16
width=420
outer-margin=20
padding=10,15
border-size=2
border-radius=2
max-icon-size=44

background-color=#294677
text-color=#d7e2ff
border-color=#acc7ff
# Per-mode settings

[mode=do-not-disturb]
invisible=1
on-notify=none

[mode=silent]
on-notify=none

[urgency=high]
background-color=#1e2025
text-color=#ffb4ab
border-color=#93000a

[app-name=Spotify]
invisible=1

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=critical]
default-timeout=0
layer=overlay
