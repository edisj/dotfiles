#!/usr/bin/env zsh

source "$HOME/.local/scripts/lib/logging.sh"
source "$HOME/.local/scripts/lib/require.sh"
require nvim fd

dir="${1:-$(pwd)}"
dir=$(readlink -f $dir)

[ ! -d $dir ] && error "$dir does not exist" && exit 1

TAB=$'\t'
readonly FZF_ARGS=(
    --height "${FZF_HEIGHT:-50%}"
    --padding "${FZF_PADDING:-0}"
    --layout reverse
    --preview "bat --color=always --style=numbers $dir/{} 2>/dev/null || eza --tree --color=always --level 3 $dir/{}"
    --preview-window "right:60%:wrap"
    --preview-border 'thinblock'
    --wrap-sign "$TAB "
    --tabstop 4
    --with-nth -1
    --scheme path
    --bind "enter:become(nvim $dir/{})"
)

fd . -t f --hidden --base-directory "$dir" | fzf "${FZF_ARGS[@]}" "${@:2}"
